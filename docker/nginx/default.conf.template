# kubeswift-ui: static SPA server + optional same-origin reverse-proxy to the
# kubeswift-gateway.
#
# Rendered into /etc/nginx/conf.d/default.conf at container start by the stock
# nginx envsubst entrypoint (20-envsubst-on-templates.sh). Only ${KUBESWIFT_*}
# tokens are substituted (they are env vars); nginx's own $variables are
# preserved because they are NOT in the environment. See docker/entrypoint.d/.

# WebSocket upgrade map for the raw-WS planes. http{} context (conf.d files are
# included inside http{}); must sit outside the server block.
map $http_upgrade $kubeswift_connection_upgrade {
    default upgrade;
    ''      close;
}

# Request path with the query string stripped, for the access log below.
map $request_uri $kubeswift_path {
    ~^(?<p>[^?]*)  $p;
    default        $request_uri;
}

# Access-log format that logs the PATH, not $request.
#
# The three raw-WebSocket planes carry the OIDC bearer as ?token= -- a browser
# cannot set an Authorization header on a WebSocket -- and the stock `combined`
# format logs $request, which includes the query string. Every console /
# sandbox-exec / sandbox-logs handshake therefore wrote a live, replayable ID
# token into this pod's own access log, where anyone holding `pods/log` on the
# namespace (and every log shipper) could read it. Dropping the whole query
# rather than just `token` keeps that true for any parameter added later.
log_format kubeswift '$remote_addr - $remote_user [$time_local] '
                     '"$request_method $kubeswift_path $server_protocol" '
                     '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

gzip on;
gzip_comp_level 5;
gzip_min_length 256;
gzip_proxied any;
gzip_types text/plain text/css application/javascript application/json
           image/svg+xml application/wasm;

server {
    listen       8080;
    listen       [::]:8080;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    access_log /var/log/nginx/access.log kubeswift;

    # Security headers, `always` so they are set on error responses too.
    #
    # frame-ancestors / X-Frame-Options are the load-bearing ones: the VM serial
    # console and the sandbox exec terminal pipe keystrokes straight into a
    # guest, so a framed UI plus an overlay is a keystroke-injection primitive
    # against a root shell.
    #
    # This is deliberately NOT a full CSP -- script-src/connect-src depend on
    # gateway.mode (same-origin proxy vs an absolute URL known only at runtime),
    # so a complete policy needs the entrypoint to compute connect-src. Tracked
    # separately; frame-ancestors is correct in every mode.
    #
    # nginx gotcha: add_header is inherited by a location ONLY if that location
    # declares no add_header of its own. The two locations below that set
    # Cache-Control therefore repeat these.
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # Cluster DNS, extracted from /etc/resolv.conf at startup
    # (10-kubeswift-resolver.envsh). Lets the variable proxy_pass below resolve
    # the gateway Service name at REQUEST time, so nginx still starts when no
    # gateway is reachable yet (pod ordering) or at all (gateway.mode=url).
    resolver ${KUBESWIFT_RESOLVER} valid=30s ipv6=off;
    set $kubeswift_gateway_upstream ${KUBESWIFT_GATEWAY_UPSTREAM};

    # Runtime gateway-URL shim (window.__KUBESWIFT_GATEWAY_URL__). Regenerated
    # each start from KUBESWIFT_GATEWAY_URL; never cache it, or a URL change
    # would not take effect on redeploy.
    location = /config.js {
        add_header Cache-Control "no-store" always;
        # Repeated because this location declares an add_header of its own — see
        # the inheritance note in the server block.
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        default_type application/javascript;
        try_files $uri =404;
    }

    # The UI pod's OWN health (NOT proxied) — reports whether nginx is serving.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---- Reverse-proxy to the gateway (gateway.mode=proxy) ------------------
    # The browser then uses ONE origin (the UI's): Connect RPCs and the console
    # WebSocket are forwarded to the in-cluster kubeswift-gateway Service. In
    # gateway.mode=url these locations are simply never hit (the SPA calls the
    # gateway's absolute URL directly).

    # Connect / gRPC-Web RPCs: every kubeswift.v1 service shares this prefix
    # (POST /kubeswift.v1.<Service>/<Method>).
    location /kubeswift.v1. {
        proxy_pass http://$kubeswift_gateway_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Clear hop-by-hop Connection so keep-alive works; the gateway speaks
        # the Connect protocol over HTTP/1.1 (h2c falls back to 1.1).
        proxy_set_header Connection "";
        # Server-streaming RPCs (WatchGuests/WatchMigrations/WatchClusters) must
        # flush incrementally rather than buffer to completion.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Raw-WebSocket planes (not Connect), each with a query string. ALL THREE
    # must be listed: only /console was proxied, so sandbox logs and sandbox
    # exec fell through to the SPA fallback below and the handshake got a 200
    # with index.html instead of a 101 -- both features were dead in the default
    # gateway.mode=proxy deployment, failing as an opaque "connection closed".
    #
    # This regex location must stay ABOVE the static-asset regex: nginx tries
    # regex locations in order of appearance.
    # proxy_pass carries NO URI part -- required in a regex location, and it is
    # what makes nginx forward the original request URI (query string included,
    # which is where these planes carry cluster/namespace/name).
    location ~ ^/(console|sandbox-logs|sandbox-exec)$ {
        proxy_pass http://$kubeswift_gateway_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $kubeswift_connection_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # ---- Static SPA ---------------------------------------------------------
    # Hashed build assets (main-XXXX.js, styles-XXXX.css, ...) are immutable.
    location ~* \.(?:js|css|woff2?|ttf|eot|otf|svg|png|jpg|jpeg|gif|ico|webp|map)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        # Repeated because this location declares an add_header of its own — see
        # the inheritance note in the server block. nosniff is the one that
        # matters on a script/style response.
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    # Angular client-side routing: every other path falls back to index.html so
    # deep links (e.g. /migrations) load the app shell.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
